[Unit]
Description=Media Storage Microservice
After=network.target postgresql.service

[Service]
Type=simple
User=media-storage
Group=media-storage
WorkingDirectory=/opt/media-storage
EnvironmentFile=/etc/media-storage.env
ExecStart=/home/media-storage/.bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/media-storage

[Install]
WantedBy=multi-user.target
