# HTTP server
PORT=3100
HOST=0.0.0.0

# Shared secret required via `X-API-Key` header for POST /media and DELETE /media/:id.
# Generate one with: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# PostgreSQL connection string used by Bun.sql
DATABASE_URL=postgres://media_storage:change-me@localhost:5432/media_storage

# Absolute path where original files + generated variants are written on disk
STORAGE_ROOT=/var/lib/media-storage/data

# Upload limits / processing
MAX_UPLOAD_SIZE_BYTES=524288000
THUMBNAIL_SIZE=300
MEDIUM_MAX_DIMENSION=1200
POSTER_MAX_WIDTH=600

# External binaries (override if not on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Allow-lists (comma-separated)
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime

LOG_LEVEL=info
BUN_ENV=production
