# Copy to .env.live.local and fill in. Gitignored. Never commit.
#
#   cp .env.live.local.example .env.live.local
#
# How scripts/live-tunnel.sh reaches the live database. Only this file holds
# the live credentials; .env.production.local holds the stack's settings and
# gets the connection string composed for it at run time.

# --- The VPS -----------------------------------------------------------------
VPS_HOST=""
VPS_USER=""

# Where the checkout lives on the box. The deploy workflow defaults to the same
# path; override only if yours differs.
VPS_APP_DIR="$HOME/zup/zuptech"

# Optional. Leave empty to use whatever your ~/.ssh/config already resolves for
# this host — the tunnel container bind-mounts ~/.ssh read-only, so an agent or
# a configured IdentityFile works with no extra setup. If you set it, give the
# path on THIS machine; it must live under ~/.ssh to be visible in the container.
VPS_SSH_KEY=""

# --- Database roles ----------------------------------------------------------
# Read-only. This is the default the tunnel opens with, and the one you should
# be in almost all the time. Create the role once on the VPS:
#
#   docker compose --env-file .env.production exec -T db \
#     psql -U postgres -d zuptech -v ro_password="'PICK-ONE'" \
#     < deploy/live-readonly-role.sql
#
LIVE_DB_RO_PASSWORD=""

# Read-write: the real `zuptech` owner role, same value as ZUPTECH_DB_PASSWORD
# in the VPS's .env.production. Only used when you pass --write, which also
# takes a full backup before the tunnel opens.
#
# Leave this EMPTY unless you actually need write mode. An empty value makes
# `live-tunnel.sh up --write` fail closed instead of succeeding by accident.
LIVE_DB_RW_PASSWORD=""
