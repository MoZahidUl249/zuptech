# Copy to .env.production.local and fill in. Gitignored. Never commit.
#
#   cp .env.production.local.example .env.production.local
#
# Settings for the production stack when it runs on a WORKSTATION against the
# live database (scripts/live-stack.sh). It is .env.production's local twin:
# same variable names, same compose file, different values in the few places
# where "local" and "live" must not be the same thing.
#
# DATABASE_URL is deliberately absent — scripts/live-stack.sh composes it from
# the tunnel's current mode so the role can never be stale. See .env.live.local.

# --- Local domains -----------------------------------------------------------
# Rendered into the real nginx template by envsubst. Add to /etc/hosts:
#   127.0.0.1  zuptech.local www.zuptech.local api.zuptech.local
APP_DOMAIN=zuptech.local
API_DOMAIN=api.zuptech.local

# Unused locally — scripts/live-stack.sh always builds, never pulls.
REGISTRY=local
TAG=local

# --- Unused, but compose still demands them ----------------------------------
# The `db` service never starts here (deploy/live-db.override.yml puts it behind
# a profile), but compose interpolates the whole file before it decides what to
# run, and these are declared `${VAR:?}` in docker-compose.yml. Placeholders are
# correct: nothing reads them. Do NOT paste the real production passwords here.
POSTGRES_USER=unused
POSTGRES_PASSWORD=unused-local-placeholder
ZUPTECH_DB_PASSWORD=unused-local-placeholder

# --- Auth --------------------------------------------------------------------
# A local-only secret. Generate your own: openssl rand -hex 32
#
# Do NOT reuse the production BETTER_AUTH_SECRET. Sessions are signed with it,
# so sharing it would let a session minted on a laptop authenticate against the
# real site.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=https://api.zuptech.local:8444
CORS_ORIGINS=https://zuptech.local:8444

# --- Cloudinary --------------------------------------------------------------
# The live account, so live product photos actually render — their URLs are
# absolute and stored on the rows this stack is reading.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# But a DIFFERENT folder, so anything uploaded during a local test is
# quarantined instead of landing in the live media folder. Leave this alone.
CLOUDINARY_FOLDER_PREFIX=zuptech-localtest

# --- Mail --------------------------------------------------------------------
# EMPTY, DELIBERATELY, AND IT MUST STAY EMPTY.
#
# In read-write mode this stack is talking to the real customer table. Real SMTP
# credentials here plus one "forgot password?" test sends a real password-reset
# code to a real customer's inbox. With SMTP_HOST empty, src/lib/mail.ts logs
# the code to the container instead — which is also the only way to read it.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ZUP TECH (local) <no-reply@zuptech.local>

# --- Everything else ---------------------------------------------------------
# No local error reporting: a fault on a laptop is not an incident.
ERROR_WEBHOOK_URL=

# One hop, same as production — the local nginx is the only proxy in front.
TRUSTED_PROXY_HOPS=1

# Handy locally, off in production.
OPENAPI_DOCS=true

# --- Baked into the frontend bundle at BUILD time ----------------------------
# Which is why scripts/live-stack.sh always passes --build. A pulled image
# carries production's values and would point next/image and every absolute URL
# at the real site.
NEXT_PUBLIC_SITE_URL=https://zuptech.local:8444
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
