# Copy to .env.production ON THE VPS and fill in. Never commit the real file.
#   docker compose --env-file .env.production up -d

# --- Domains ---
# Rendered into the nginx config at container start (deploy/nginx/templates/).
# Both names must have an A record pointing at this VPS, and both live on ONE
# certificate issued under APP_DOMAIN — see DEPLOYMENT.md §4.
#
# NOTE: the browser-facing URLs are NOT set here. NEXT_PUBLIC_SITE_URL and
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME are compiled into the JavaScript bundle at
# build time, so they live in the GitHub repository Variables the deploy
# workflow passes as build args. Changing the domain means changing BOTH
# places and pushing a commit — restarting the stack is not enough.
APP_DOMAIN=example.com
API_DOMAIN=api.example.com

# Registry + tag the deploy workflow publishes to.
# Must be exactly ghcr.io/<owner>/<repo>, all lowercase — the workflow pushes
# to ghcr.io/${{ github.repository }}, and anything else here makes
# `docker compose pull` fail on an image that was never published.
REGISTRY=ghcr.io/owner/repo
TAG=latest

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # openssl rand -hex 24
ZUPTECH_DB_PASSWORD=          # openssl rand -hex 24

# --- Backend ---
# Keep these in step with the domains above — they are written out in full
# because they are URLs, not bare hostnames.
BETTER_AUTH_SECRET=           # openssl rand -hex 32
BETTER_AUTH_URL=https://api.example.com
CORS_ORIGINS=https://example.com

# --- Cloudinary (media storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=zuptech-prod

# --- SMTP (password-reset OTP delivery) ---
# REQUIRED in production: with SMTP_HOST empty the code is written to the
# container log instead of being emailed, so nobody can reset their password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=                  # true for port 465; blank is fine otherwise
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ZUP TECH <no-reply@example.com>

# --- Operations (all optional; defaults are the safe ones) ---
# Where faults go besides the container log. Every 500 is POSTed here as JSON
# with the request id the caller was shown, so "it said something went wrong"
# can be matched to one stack. Any endpoint that accepts JSON works — a Slack
# incoming webhook, a Sentry ingest URL. Left blank, nothing is alerted and a
# fault is only ever found by reading logs.
ERROR_WEBHOOK_URL=

# Proxies in front of the backend. Rate limiting reads the client IP this many
# hops from the right of X-Forwarded-For; too low and a caller can spoof a
# fresh bucket, too high and everyone shares one. 1 = the nginx in this stack.
# Raise it only if you put a CDN in front.
TRUSTED_PROXY_HOPS=1

# Serve the live OpenAPI docs at /openapi in production. Off unless set to
# true — it describes every admin endpoint.
OPENAPI_DOCS=

# --- Frontend (BAKED AT BUILD TIME — changing these needs a rebuild) ---
# Compose interpolates the whole file eagerly, so these must be set here even
# though the VPS pulls prebuilt images rather than building them — the
# frontend service's `build.args` reference them and `up -d` aborts otherwise.
#
# They do NOT reach the running image. The values actually compiled into the
# browser bundle come from the GitHub repository Variables of the same name,
# passed as build args by .github/workflows/deploy.yml. Keep the two in sync;
# if they ever disagree, the GitHub Variables are what visitors get.
NEXT_PUBLIC_SITE_URL=https://example.com
# Same value as CLOUDINARY_CLOUD_NAME above — not a secret, just the account
# identifier next/image needs to allow-list res.cloudinary.com/<cloud_name>/**.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
