# Copy to .env.production ON THE VPS and fill in. Never commit the real file.
#   docker compose --env-file .env.production up -d

# Registry + tag the deploy workflow publishes to.
REGISTRY=ghcr.io/YOUR_GH_USER/zuptech
TAG=latest

# --- Postgres (one container, two databases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # openssl rand -hex 24
ZUPTECH_DB_PASSWORD=          # openssl rand -hex 24
MEDIA_DB_PASSWORD=            # openssl rand -hex 24

# --- Backend ---
BETTER_AUTH_SECRET=           # openssl rand -hex 32
BETTER_AUTH_URL=https://api.zuptech.com.bd
CORS_ORIGINS=https://zuptech.com.bd

# --- Storage (shared secret; backend sends it as X-API-Key) ---
STORAGE_API_KEY=              # openssl rand -hex 32

# --- Frontend (BAKED AT BUILD TIME — changing these needs a rebuild) ---
NEXT_PUBLIC_SITE_URL=https://zuptech.com.bd
# Must be a PUBLIC https origin. next/image refuses to optimize a host that
# resolves to a private IP, so localhost/127.0.0.1 makes every image 400.
NEXT_PUBLIC_STORAGE_URL=https://media.zuptech.com.bd
