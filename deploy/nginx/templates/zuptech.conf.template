# RENDERED AT CONTAINER START — this is a template, not a live config.
#
# The nginx image runs envsubst over /etc/nginx/templates/*.template and writes
# the result to /etc/nginx/conf.d/. Only ${APP_DOMAIN} and ${API_DOMAIN} are
# substituted: docker-compose.yml sets NGINX_ENVSUBST_FILTER='_DOMAIN$' so that
# nginx's own runtime variables ($host, $remote_addr, $scheme, …) survive
# untouched. Adding a new ${PLACEHOLDER} means naming it *_DOMAIN or widening
# that filter — otherwise it renders as an empty string and nginx starts with
# a silently broken config.
#
# All three hostnames share ONE certificate, issued under ${APP_DOMAIN} (see
# DEPLOYMENT.md §4), which is why every block points at the same live/ path.
#
# Media (product photos/video, hero images, service images) is served
# straight from Cloudinary's own CDN, so there is no media vhost here.

# Upstreams are compose service names on the internal network.
upstream storefront { server frontend:3001; }
upstream api        { server backend:3000; }

# ACME + HTTP->HTTPS. Keep this server block on :80 permanently; certbot
# renews through it.
server {
    listen 80;
    server_name ${APP_DOMAIN} www.${APP_DOMAIN} ${API_DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# ---------- www -> apex ----------
# The apex is the canonical host: it is what NEXT_PUBLIC_SITE_URL, the
# canonical tag, the sitemap and CORS_ORIGINS all use. Both names used to
# serve the site identically with no redirect, which split it two ways:
# search engines saw duplicate content on two hosts, and — because Better
# Auth issues host-only cookies (no cookie domain is configured) — a session
# started on www was simply not sent to the apex, so signing in on one host
# and arriving on the other logged you out.
server {
    listen 443 ssl;
    http2 on;
    server_name www.${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    return 301 https://${APP_DOMAIN}$request_uri;
}

# ---------- storefront ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://storefront;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }
}

# ---------- API ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    # Admin photo/video uploads proxy through the API to Cloudinary.
    client_max_body_size 320m;

    location / {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
