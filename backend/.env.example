# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL connection string.
# Production (provider-internal host — only resolves inside the private network):
# DATABASE_URL="postgres://postgres:<password>@fb405oxjhtdoc0yd2gtauihh:5432/postgres"
DATABASE_URL=""

# Long random string, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=""
# Public base URL of THIS backend (used for auth cookies/callbacks).
BETTER_AUTH_URL="https://api.zuptech.com"

PORT=3000
# Comma-separated origins allowed by CORS (the storefront's origin).
CORS_ORIGINS="https://zuptech.com"

# Base URL of the media-storage service (../storage) — reachable by both this
# server (uploads/deletes) and the browser (GET /files/... is public/unauthed).
STORAGE_URL="http://localhost:3100"
# Must match the storage service's own API_KEY. Sent as X-API-Key, never
# exposed to the browser — only used server-side in src/lib/storage.ts.
STORAGE_API_KEY=""

# SMTP — delivers password-reset OTPs (src/lib/mail.ts). Leave SMTP_HOST empty
# in local dev: the code is logged to the server console instead of sent, so
# the reset flow is testable with no credentials.
SMTP_HOST=""
SMTP_PORT="587"
# Implicit TLS. Defaults to true on port 465, false otherwise.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Envelope From — must be an address the SMTP provider is allowed to send as.
MAIL_FROM="ZUP TECH <no-reply@zuptech.com>"
