// ZUP TECH backend — Prisma schema (PostgreSQL)
//
// Connection URL lives in prisma.config.ts (Prisma 7), sourced from
// DATABASE_URL. Status fields are plain strings (validated at the API layer
// with Elysia schemas) so payloads stay byte-identical to the frontend types
// in BACKEND.md — e.g. "On the way", which Prisma enums can't express.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

/// ===== Catalog =====

/// Top level of the catalog taxonomy — the audience split the storefront's
/// primary filter uses ("Home", "Industrial"). Sections own categories;
/// products hang off categories, never off a section directly.
model Section {
  id   String @id @default(cuid())
  name String @unique
  sort Int    @default(0)

  categories Category[]
}

/// Merchandising category ("Solar", "Protection", …). `name` is globally
/// unique, so a category belongs to exactly one section — that is what makes
/// the section reachable from a product through a single hop.
model Category {
  id        String  @id @default(cuid())
  name      String  @unique
  svgLogo   String  @default("") // SVG markup, "" = none
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
  sort      Int     @default(0)

  products Product[]

  @@index([sectionId])
}

/// One row per sellable product. Merges the storefront shape (lib/products.ts)
/// with the admin extras (AdminProduct) — the API decides which fields each
/// audience sees.
model Product {
  id          String  @id // storefront id, e.g. "ips1000"
  slug        String  @unique // used in URLs + SEO, keep stable
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  price       Int // BDT
  /// Minimum down payment, as a whole percentage of price (0–100).
  ///
  /// This was the deposit in BDT until 2026-08-13, and the column deliberately
  /// was not a percentage — see `salePrice` below for the rounding mess that
  /// reasoning came from. It is a percentage now because the storefront states
  /// it as one, and it is SAFE here only because it is display-only: nothing in
  /// pricing, order creation or checkout reads this field.
  ///
  /// If checkout ever does take deposits, resolve it to taka ONCE, server-side,
  /// and store that number on the order. Do not recompute the percentage in the
  /// admin and again on the product page — that is precisely how a ৳999 product
  /// came to show ৳669 and charge ৳670.
  minDepositPct Int   @default(0)
  onSale      Boolean @default(false)
  /// The discount the admin types, 0–100. SOURCE of the sale as of 2026-08-13.
  salePct     Int     @default(0)
  /// What the customer pays while `onSale`, in BDT. Still the only money field
  /// any reader touches — but it is now COMPUTED from `salePct` rather than
  /// typed, by `salePriceFrom` in lib/rules.ts.
  ///
  /// A percentage column existed before and was removed, because the same
  /// percentage got rounded three different ways — the server floored it, the
  /// admin preview rounded it, the product card rounded again off a different
  /// base — so a ৳999 product at 33% off showed ৳669 and charged ৳670. What
  /// makes this safe is that the arithmetic happens ONCE, on write, and the
  /// result is stored here. Nothing recomputes a price from `salePct` at
  /// render time; the card prints it as a label, never as an input to a sum.
  ///
  /// Consequence: a change to `price` MUST recompute this. The admin write
  /// path does. Anything else that edits `price` has to as well, or the
  /// advertised percentage and the charged amount drift apart again.
  salePrice   Int     @default(0)
  rating      Float   @default(0)
  sold        Int     @default(0)
  imgHint     String   @default("")
  specs       String[] @default([]) // 4 bullet points
  description String   @default("")
  video       String   @default("") // promo video URL (YouTube etc.), "" = none

  /// Products to show under this one, in this order. Curated per product — the
  /// storefront shows exactly these and hides the row when empty.
  ///
  /// An ordered id array rather than a join table, matching
  /// `SiteConfig.featuredIds`, which is the same shape and already has both
  /// halves of the pattern: `getProductsByIds` resolves a list and silently
  /// drops ids that no longer resolve, and the admin picker filters out
  /// products that have since been deleted or hidden. A relation would add
  /// referential integrity and a cascade path through the product-delete
  /// rules, which are load-bearing and were fixed only recently.
  recommendedIds String[] @default([])

  /// Manual override for the storefront's status tag, "" = derive it.
  ///
  /// Derivation lives in `stockTagFor` (lib/rules.ts): in stock shows nothing,
  /// nothing available shows "Out of stock", and nothing available with an
  /// in-transit purchase order shows "Incoming". "Sold out" is only ever set
  /// by hand — automatically it would be indistinguishable from "Out of
  /// stock", and it exists to say a line is finished for good.
  stockTag       String   @default("")

  // Admin-side extras
  sku             String  @unique // e.g. "ZT-IPS-1000"
  cost            Int     @default(0) // purchase cost (BDT) — drives stock value
  stock           Int     @default(0) // on hand
  reserved        Int     @default(0) // allocated to open orders
  reorderAt       Int     @default(0) // low-stock threshold
  visible         Boolean  @default(true)
  photos          String[] @default([]) // ordered gallery URLs, first = cover photo; any count

  // Delivery + installation, BDT per unit, flat two-tier zone pricing
  deliveryFeeInsideDhaka      Int @default(0)
  deliveryFeeOutsideDhaka     Int @default(0)
  installationFeeInsideDhaka  Int @default(0)
  installationFeeOutsideDhaka Int @default(0)

  warrantyMonths Int @default(0) // 0 = no warranty; drives Warranty rows on delivery

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems         OrderItem[]
  purchaseOrders     PurchaseOrder[]
  movements          StockMovement[]
  quantityOffers     QuantityOffer[]
  freeDeliveryOffers FreeDeliveryOffer[]
  warranties         Warranty[]
  landingPages       LandingPage[]

  @@index([categoryId])
  // The storefront listing, in the order it actually runs: filter on
  // `visible`, sort newest-first, take a page. Without this, GET /api/products
  // was a Seq Scan over every product plus a top-N heapsort to return 48 rows
  // — measured reading all 5,010 rows and 264 buffers per request, and the
  // paged route runs the matching COUNT alongside it, so that was twice per
  // page view on the busiest dynamic route on the site. Column order matters:
  // the equality column first, then the sort column, so Postgres can walk the
  // index backwards and stop at the page boundary.
  @@index([visible, createdAt])
}

/// A "buy N+, take ৳X off each unit" tier on a product. A product may have
/// several tiers; the highest minQty a cart line's qty satisfies wins — see
/// rules.ts `bestQuantityOffer`. The tier price is compared against the flat
/// sale price and the customer always gets whichever is lower (never stacked —
/// see rules.ts `effectiveUnitPrice`).
model QuantityOffer {
  id        Int     @id @default(autoincrement())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int // qty threshold, e.g. 3 = "buy 3 or more"
  amount    Int // BDT off product.price per unit at this tier

  @@unique([productId, minQty])
  @@index([productId])
}

/// A "buy N+, take ৳X off delivery" tier on a product. Same shape and same
/// resolution rule as QuantityOffer: the highest minQty a cart line's qty
/// satisfies wins, tiers never stack — see rules.ts `deliveryDiscountAmount`.
/// The discount applies to whichever zone fee the order resolves to
/// (deliveryFeeInsideDhaka / deliveryFeeOutsideDhaka) and is clamped at that
/// fee, so an amount at or above it means the line ships free and the fee can
/// never go negative.
model FreeDeliveryOffer {
  id        Int     @id @default(autoincrement())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int // qty threshold, e.g. 3 = "buy 3 or more"
  amount    Int // BDT off the per-unit zone delivery fee at this tier

  @@unique([productId, minQty])
  @@index([productId])
}

/// ===== Orders & customers =====

model Customer {
  id       String   @id @default(cuid())
  name     String
  phone    String   @unique // normalized 01XXXXXXXXX — this IS the login identity
  /// Real, deliverable address — where password-reset OTPs are sent. Distinct
  /// from User.email, which holds the synthetic `{phone}@customers.zuptech.local`
  /// identifier Better Auth signs in with. Null on guest-checkout rows and on
  /// accounts created before email was collected; those can't self-reset.
  email    String?  @unique
  address  String   @default("") // last-used delivery address (free text) — prefills checkout
  insideDhaka Boolean @default(true) // last-used delivery zone — drives per-product delivery/installation fee
  joinedAt DateTime @default(now())

  orders Order[]
}

model Order {
  id              String   @id // display id, e.g. "ZT-10241"
  number          Int      @unique // sequential part of the id, for ordering
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  name            String // recipient full name as entered at checkout
  phone           String
  address         String // free text, frozen with the delivery zone label appended at order time
  insideDhaka     Boolean // delivery zone at order time, frozen
  subtotal        Int
  deliveryFee     Int
  installationFee Int      @default(0) // Σ product installation fee (zone-specific) × qty
  total           Int
  pay             String // chosen payment method name
  status          String   @default("Processing") // Processing|Confirmed|On the way|Delivered|Cancelled
  /// Staff member accountable for fulfilling this order. Null until someone
  /// claims or is assigned it; SetNull so removing a staff row never deletes
  /// order history (the OrderEvent trail keeps their name either way).
  preparedById    String?
  preparedBy      Staff?   @relation("OrderPreparedBy", fields: [preparedById], references: [id], onDelete: SetNull)
  /// The campaign page this order came from, when it came from one.
  ///
  /// Nullable because most orders are ordinary storefront checkouts, and an
  /// order must never fail for want of an attribution. Set only when the
  /// request names a slug that resolves to a PUBLISHED page, so a guessed or
  /// stale slug attributes nothing rather than inventing a sale for a
  /// campaign that was not running.
  ///
  /// This is what makes per-campaign revenue answerable at all: `orderCount`
  /// on LandingPage was a counter nothing ever incremented, so every campaign
  /// reported zero sales forever. Counting rows here cannot drift from the
  /// orders it counts.
  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items      OrderItem[]
  events     OrderEvent[]
  invoice    Invoice?
  warranties Warranty[]

  @@index([status])
  @@index([createdAt])
  @@index([preparedById])

  /// The admin campaign list groups every order by campaign on each load.
  @@index([landingPageId])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  qty             Int
  unitPrice       Int // BDT at time of purchase
  deliveryFee     Int     @default(0) // per-unit delivery fee (zone-specific), snapshot at time of purchase
  installationFee Int     @default(0) // per-unit installation fee (zone-specific), snapshot at time of purchase

  warranties Warranty[]
}

/// Append-only trail of everything that happened to an order — who changed
/// the status, who claimed it, when its invoice was issued. Same shape of
/// audit as StockMovement: the actor is frozen as text so the row still reads
/// correctly after a staff member is renamed or deleted.
model OrderEvent {
  id      String   @id @default(cuid())
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  at      DateTime @default(now())
  kind    String // placed|status|prepared-by|invoice|warranty|note
  detail  String // human-readable, e.g. "Processing → Confirmed"
  by      String // staff username, or "customer"
  byName  String // display name, frozen

  @@index([orderId, at])
}

/// One invoice per order. Deliberately stores no money: Order.subtotal /
/// deliveryFee / installationFee / total and OrderItem.unitPrice are already
/// frozen snapshots taken at checkout, so the document derives its amounts
/// from the order and can never drift out of sync with it.
model Invoice {
  id         String    @id // "INV-1001"
  number     Int       @unique
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     String    @default("Draft") // Draft|Issued|Paid|Void
  issuedAt   DateTime?
  paidAt     DateTime?
  notes      String    @default("")
  issuedById String?
  issuedBy   Staff?    @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

/// Warranty registry — one row per delivered order line whose product has a
/// warranty period. Created automatically when an order reaches "Delivered"
/// (see lib/warranty.ts) and thereafter edited by staff to record serials and
/// claims.
model Warranty {
  id          String    @id // "WR-4401"
  number      Int       @unique
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  sku         String // denormalized for display, survives product edits
  qty         Int
  serialNo    String    @default("") // free text; comma-separate multiple units
  months      Int
  startsAt    DateTime
  endsAt      DateTime
  status      String    @default("Active") // Active|Expired|Claimed|Replaced|Void
  claimNote   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([serialNo])
}

/// Monotonic counters for human-friendly sequential ids (ZT-10242, PO-2212,
/// INV-1001, WR-4401…).
model Counter {
  id    String @id // "order" | "po" | "invoice" | "warranty"
  value Int
}

/// One recorded attempt against a rate-limited action.
///
/// The limiter for auth was purely in-process, which meant every deploy wiped
/// the lockouts — restart the container and a brute-force attempt starts from
/// zero — and it would have counted separately per instance the moment this
/// runs on more than one. Auth attempts are low-volume, so a row per attempt
/// is affordable and gives both durability and a shared count.
///
/// Cheap paths (pricing quotes, lead forms, campaign view counts) deliberately
/// stay on the in-memory limiter: they are high-volume and low-stakes, and a
/// database write per request would cost more than the abuse it prevents.
model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

/// ===== Leads & contact =====

model ServiceLead {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  customer  String
  /// Where the work is. This was `city` and required, which is why the booking
  /// form used to post the literal string "Not given" when it was left blank.
  address   String   @default("")
  phone     String   @default("")
  /// Its own column rather than a line inside `notes` — staff need to be able
  /// to reply to the person, not read an address out of a paragraph.
  email     String   @default("")
  notes     String   @default("")
  status    String   @default("New") // New|Contacted|Survey booked|Quoted|Won|Lost
  createdAt DateTime @default(now())

  @@index([serviceId])
}

/// Unlisted single-product campaign page for ad traffic (`/lp/:slug`), used
/// to sell via Facebook ad hyperlinks. Never linked from the store nav, never
/// in the sitemap, never crawlable — the share link is the only way in.
///
/// The point of the model is that a campaign can sell a product that is NOT
/// live on the storefront (`Product.visible = false`): the landing page is
/// then the only place it is purchasable. See `orderableProductWhere()` in
/// lib/rules.ts — a product is orderable when it is visible OR carried by at
/// least one *published* landing page.
model LandingPage {
  id        String  @id @default(cuid())
  /// Internal name shown in the admin list — never rendered publicly.
  title     String
  /// The public <h1> on /lp/:slug. Blank falls back to the product name, so
  /// a page created from the admin's "New landing page" button can never
  /// headline ad traffic with the internal placeholder.
  headline  String  @default("")
  slug      String  @unique
  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Campaign price shown to the visitor, and the struck-through reference
  /// beside it. Display only — the order still prices from the catalog via
  /// priceCart(), so a landing page can never move real money on its own.
  offerPrice     Int
  compareAtPrice Int

  ribbonText     String   @default("")
  buttonLabel    String   @default("Buy Now")
  footerNote     String   @default("")
  benefitBullets String[] @default([])
  imageHint      String   @default("")

  /// ===== Campaign page content =====
  ///
  /// Every string a visitor can read on /lp/:slug lives here, so a campaign is
  /// written entirely from the admin — including in Bangla. Nothing below is
  /// money: prices come from the product, and the bundle ladder is rendered
  /// from `Product.quantityOffers`, so an advertised bundle total is by
  /// construction the total the cart charges.
  ///
  /// The repeatable blocks are Json rather than child tables because they are
  /// copy, edited as a whole page and never queried across campaigns.

  /// Header: hotline strip + the button beside it.
  hotlineLabel    String @default("")
  hotlineNumber   String @default("")
  headerCtaLabel  String @default("")

  /// Hero: the badges above the headline, the standfirst under it, and the
  /// discount flag on the pack shot.
  trustBadges   String[] @default([])
  subheadline   String   @default("")
  discountBadge String   @default("")
  heroCtaNote   String   @default("")

  /// "যাদের সাথে আমরা কাজ করি" + the payment/courier names under it.
  brandStripTitle String   @default("")
  brandLogos      String[] @default([])

  /// Product video block. `videoUrl` blank hides the whole section.
  videoTitle String @default("")
  videoUrl   String @default("")

  /// A video in the hero, in place of the pack shot. Blank falls back to the
  /// product photo, so a campaign without one looks exactly as it did.
  ///
  /// Separate from `videoUrl` above rather than a flag on it: the two answer
  /// different questions. The hero video is the thing that sells above the
  /// fold, and the section below is the longer demo — a campaign can run
  /// either, both, or neither. Same accepted forms as `Product.video`
  /// (YouTube link or an uploaded file URL); parsing is the frontend's
  /// `parseProductVideo`, so an unusable URL renders nothing rather than a
  /// broken embed.
  heroVideoUrl String @default("")

  /// Numbered feature list: [{ title, body }]
  featuresTitle String @default("")
  features      Json   @default("[]")

  /// Spec sheet: a model/revision line plus stat cells [{ value, label }]
  specTitle String @default("")
  specMeta  String @default("")
  specs     Json   @default("[]")

  /// Bundle ladder. Only the wording is stored — every price shown is derived
  /// from the product's quantity offers at render time.
  bundlesTitle    String @default("")
  bundlesSubtitle String @default("")
  bundleUnitLabel String @default("")
  bundleMaxQty    Int    @default(3)

  /// Quality-control / anti-counterfeit block.
  qcTitle     String   @default("")
  qcBody      String   @default("")
  qcPoints    String[] @default([])
  /// A Cloudinary URL, uploaded per campaign. Blank falls back to the striped
  /// placeholder captioned with `qcImageHint` below.
  ///
  /// Landing pages had no image of their own at all: `qcImageHint` was only a
  /// note describing the art that belonged there, so this block rendered a
  /// grey wireframe on every published campaign and nothing could change it.
  qcImage     String   @default("")
  /// What the picture should show. Art direction for whoever uploads it, and
  /// the caption on the placeholder until they do.
  qcImageHint String   @default("")

  /// Urgency block. `countdownEndsAt` null hides the timer but keeps the copy.
  countdownTitle     String    @default("")
  countdownNote      String    @default("")
  countdownEndsAt    DateTime?
  countdownCtaLabel  String    @default("")
  countdownAssurance String    @default("")

  /// Reviews: [{ quote, name, location }]
  testimonialsTitle String @default("")
  testimonials      Json   @default("[]")

  /// The inline cash-on-delivery order form. `formLabels` holds every field
  /// label and the summary rows, so the whole form can be written in Bangla.
  formTitle  String @default("")
  formIntro  String @default("")
  formLabels Json   @default("{}")

  /// Footer.
  footerTagline String   @default("")
  footerAbout   String   @default("")
  footerLines   String[] @default([])
  /// ===== Theme =====
  ///
  /// Every colour the page paints with, per campaign. A direct-response page
  /// is sold on its look as much as its copy, and two campaigns running at
  /// once should not have to share a palette — so these are columns, not a
  /// site-wide theme.
  ///
  /// Hex strings, validated at the DTO. Named for the ROLE each plays rather
  /// than the colour it happens to hold, so a campaign can be recoloured
  /// without every name turning into a lie ("colorGreenBand" going blue).
  ///
  /// Defaults are the reference design's palette, so a new page looks
  /// deliberate before anyone opens the colour controls.
  colorHeroBg      String @default("#17341B") // deep band behind the headline
  colorHeroText    String @default("#FFFFFF")
  colorBandBg      String @default("#45712F") // the price/statement bands
  colorBandText    String @default("#FFFFFF")
  colorTintBg      String @default("#F2F5EC") // testimonials, quiet sections
  colorPageBg      String @default("#FFFFFF")
  colorPageText    String @default("#15181E")
  colorAccent      String @default("#45712F") // links, ticks, emphasis
  colorHighlight   String @default("#FFF306") // the bundle-saving line
  colorCtaBg       String @default("#000000") // the order button
  colorCtaText     String @default("#FFFFFF")

  /// A product row above the page body. Ordered ids, same shape and same
  /// resolve-and-drop rules as SiteConfig.featuredIds — empty hides the row.
  productRowIds  String[] @default([])

  /// The two price-band labels ("Previous price", "Offer price"). Their own
  /// columns rather than entries in `formLabels`, which is the ORDER FORM's
  /// vocabulary — these sit in the hero bands and have nothing to do with it.
  /// Blank falls back to English in the renderer, so a campaign written only
  /// in Bangla still reads correctly the moment they are filled in.
  priceCompareLabel String @default("")
  priceOfferLabel   String @default("")

  /// This page's own GTM container, so ad spend is tracked separately from
  /// the main site's.
  gtmId          String   @default("")

  /// false = the public route 404s, and the product loses its landing-page
  /// route to orderability.
  published Boolean @default(false)

  viewCount  Int      @default(0)
  /// Orders attributed to this campaign, so revenue can be read off them.
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([published])
}

/// B2B enquiry from the /industrial page. Deliberately NOT a flag on
/// ServiceLead: an industrial deal captures a different fact set (company,
/// sector, connected load, scope, budget), runs a longer pipeline
/// (INDUSTRIAL_LEAD_STATUSES, not LEAD_STATUSES) and is worked by a different
/// team, so the two are listed and reported on separately in the admin.
model IndustrialLead {
  id String @id @default(cuid())

  /// Nullable FK, NOT required: /industrial renders DB-backed
  /// IndustrialService cards but falls back to the static list in
  /// ../fronend/lib/industrial.ts when the API is down. A submission made
  /// against a fallback card carries an id with no row behind it, so the
  /// link is best-effort and `serviceName` below is the source of truth.
  industrialServiceId String?
  industrialService   IndustrialService? @relation(fields: [industrialServiceId], references: [id], onDelete: SetNull)
  /// Snapshot of the requested service label — always populated, and kept
  /// even if the IndustrialService row is later renamed or deleted.
  serviceName         String

  company     String
  contactName String
  designation String @default("")
  phone       String
  email       String @default("")

  sector       String // INDUSTRIAL_SECTORS
  scope        String // INDUSTRIAL_SCOPES
  timeline     String // INDUSTRIAL_TIMELINES
  siteLocation String @default("")
  /// Free text ("850 kVA", "2.1 MW") — units vary by client, so no numeric
  /// column; sales reads it, nothing computes on it.
  load         String @default("")
  budget       String @default("")
  notes        String @default("")

  status    String   @default("New") // INDUSTRIAL_LEAD_STATUSES
  createdAt DateTime @default(now())

  @@index([industrialServiceId])
  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  email     String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// ===== Staff & RBAC =====

/// Permissions is a JSON record: { [module]: "none" | "view" | "manage" }
/// Modules: dashboard, analytics, orders, invoices, warranty, products,
/// inventory, leads, customers, homepage, landingpages, sitecontent,
/// payments, pricing, staff. The list of record is ADMIN_MODULES in
/// src/lib/rbac.ts — keep this comment in step with it.
model Role {
  id          String  @id
  name        String  @unique
  permissions Json // Record<Module, "none" | "view" | "manage">
  isSystem    Boolean @default(false) // Super Admin — cannot be edited/deleted

  staff Staff[]
}

/// Staff profile. Credentials (username/password) live in Better Auth's
/// User/Account tables; this row carries the business data + role link.
model Staff {
  id       String @id @default(cuid())
  name     String
  phone    String @default("")
  /// Real, deliverable address for password-reset OTPs. User.email holds the
  /// synthetic `{username}@staff.zuptech.local` identifier instead — see
  /// Customer.email for the same split on the storefront side.
  email    String? @unique
  username String @unique // mirrors the Better Auth username for easy lookup
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])
  userId   String @unique // -> User.id (Better Auth)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  preparedOrders Order[]   @relation("OrderPreparedBy")
  issuedInvoices Invoice[] @relation("InvoiceIssuedBy")
}

/// ===== Inventory =====

model Supplier {
  id      String @id @default(cuid())
  name    String
  contact String @default("")
  phone   String @default("")
  items   String @default("") // free-text "what they supply"

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String   @id // display id, e.g. "PO-2211"
  number     Int      @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  qty        Int
  value      Int // total BDT
  eta        DateTime
  status     String   @default("Confirmed") // Confirmed|In transit|Received|Cancelled
  createdAt  DateTime @default(now())

  // The storefront's "Incoming" tag asks, per product, whether an in-transit
  // order exists (`stockTagFor` in lib/rules.ts). That probe rides along with
  // GET /api/products — the busiest dynamic query on the site — so it gets an
  // index rather than a scan of every purchase order ever raised.
  @@index([productId, status])
}

/// Append-only audit trail of every stock change.
model StockMovement {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  sku       String // denormalized for display, survives product edits
  change    Int // +/- units
  reason    String
  by        String // staff username or "system"

  @@index([date])
}

/// ===== Site content (admin-managed, publicly readable) =====

model HeroSlide {
  id    String  @id @default(cuid())
  /// Media URL — only active slides WITH one render. Holds an image or a
  /// video depending on `mediaType`; the column is shared because a slide
  /// carries exactly one piece of art either way.
  image String? // URL — only active slides WITH an image render
  /// "image" | "video". Stored rather than inferred from the URL: guessing
  /// from a file extension or a Cloudinary path shape would silently break
  /// the moment either changes, and the player differs entirely.
  mediaType String  @default("image")
  cta       String
  href      String
  active    Boolean @default(true)
  fit       String  @default("cover") // "cover" | "contain"
  bg        String  @default("")
  sort      Int     @default(0)

  /// Which pages this slide appears on: any of "home", "services",
  /// "industrial".
  ///
  /// An array rather than one page because the same banner is often wanted in
  /// more than one place, and the alternative is uploading the same art twice
  /// and then having to remember to change both.
  ///
  /// Every existing slide was migrated to ["home"], which is where they all
  /// rendered before this existed — /services and /industrial used to show the
  /// homepage's carousel verbatim, which is the thing this replaces. A page
  /// with no slides of its own falls back to the built-in art, exactly as an
  /// empty set always has.
  pages String[] @default(["home"])
}

/// A person on the contact page. No slug: two colleagues can share a name, and
/// nothing links to an individual.
///
/// Seeded empty on purpose. A roster of six invented people used to be
/// hardcoded in the frontend and was deleted for that reason — publishing
/// fabricated staff for a real business is worse than publishing none. The
/// client fills this in with real, consented details.
model TeamMember {
  id    String @id @default(cuid())
  name  String
  role  String
  bio   String @default("")
  photo String @default("") // Cloudinary URL, "" = none
  sort  Int    @default(0)
}

/// The home page's showcase cards. Same card shape as Service, and a separate
/// model for the reason that matters: the front page is a shop window, not the
/// catalogue. Nothing books a ShowcaseCard — it has no lead relation — so an
/// admin can rewrite, reorder or delete what the home page shows without
/// touching a single thing the business actually sells.
///
/// The home page used to render the `Service` rows directly, which meant
/// editing the front page edited /services and vice versa.
model ShowcaseCard {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  dsc       String
  image     String   @default("") // Cloudinary URL, "" = none
  features  String[] @default([])
  sort      Int      @default(0)
  /// "left" | "right" — which half of the 50/50 storefront card the photo takes.
  imageSide String   @default("left")
  /// "tick" | "dot" | "plain" — the marker in front of each feature line.
  bulletStyle String @default("tick")
}

/// The /services page's engineering-service cards (Lighting Automation,
/// Sub-Station, BMS, etc.). `image` is a Cloudinary URL uploaded through
/// POST /admin/api/services/:id/image — replaced the fixed Lucide icon key
/// the frontend's SolutionIcon component used to require.
model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  dsc       String
  image     String   @default("") // Cloudinary URL, "" = none
  features  String[] @default([])
  sort      Int      @default(0)
  /// "left" | "right" — which half of the 50/50 storefront card the photo takes.
  imageSide String   @default("left")
  /// "tick" | "dot" | "plain" — the marker in front of each feature line.
  bulletStyle String @default("tick")

  leads ServiceLead[]
}

/// Same card shape as Service, but for the industrial/EPC offering — kept as
/// its own model (not a flag on Service) because the two lists are edited and
/// rendered separately. Service is booked via ServiceLead; this one via
/// IndustrialLead, which captures a different (B2B) fact set.
model IndustrialService {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  dsc       String
  image     String   @default("") // Cloudinary URL, "" = none
  features  String[] @default([])
  sort      Int      @default(0)
  /// "left" | "right" — which half of the 50/50 storefront card the photo takes.
  imageSide String   @default("left")
  /// "tick" | "dot" | "plain" — the marker in front of each feature line.
  bulletStyle String @default("tick")

  leads IndustrialLead[]
}

/// Singleton (id = 1): featured list, site copy, contact info, integrations.
model SiteConfig {
  id Int @id @default(1)

  featuredIds String[] @default([]) // product ids, ORDER matters (home page row)

  /// The second product row on the home page, above the two booking forms.
  /// Same shape and same rules as `featuredIds` — a separate list so the two
  /// rows can merchandise different things rather than repeating one set twice
  /// on a single page. Empty hides the row.
  homeRowIds  String[] @default([])

  // Copy.
  //
  // Flat named columns rather than a JSON blob: keeps per-field validation in
  // the DTO, needs no backfill (every column has a default), and lets
  // PUT /admin/api/copy keep writing the body straight through.
  //
  // Only singular headings/paragraphs live here. Repeating card lists are NOT
  // modelled as copy1/copy2/… columns — they either have their own model
  // (Service, IndustrialService) or stay static in the frontend.
  //
  // Blank ("") means "use the frontend's built-in default" — resolveCopy() in
  // lib/admin-bridge.ts coalesces empty strings back to DEFAULT_COPY.
  // A column earns its place by having a renderer. Twenty-one columns were
  // dropped in the site-content cleanup because the sections they fed had
  // been deleted from the pages — an admin could type into them forever and
  // no visitor would see a character. If a section comes back, add its column
  // back with it, not before.
  footerDescription String @default("")

  // Home page — the page is the banner carousel, the featured row, the
  // service cards and the two booking forms. Only the visually-hidden <h1>
  // is copy.
  homeHeroHeadline String @default("")

  // Services page
  servicesHeroHeadline String @default("")

  // Industrial page
  industrialHeroHeadline String @default("")

  // Contact page
  contactHeading      String @default("")
  contactFormHeading  String @default("")
  contactOfficeHeading String @default("")
  contactServiceLine  String @default("")
  contactTendersEmail String @default("")

  // Contact
  phone        String @default("")
  phoneDisplay String @default("")
  hotline      String @default("") // printed on invoices, not shown on the site
  email        String @default("")
  whatsapp     String @default("") // digits only
  street       String @default("")
  city         String @default("")
  postalCode   String @default("")
  hours        String @default("")

  // Office & warehouse block on the contact page. These were hardcoded in the
  // frontend (lib/contact-content.ts) with placeholder values marked as a
  // launch blocker; they are the client's to set now.
  officeName       String @default("")
  warehouseName    String @default("")
  warehouseAddress String @default("")
  hoursWeekday     String @default("")
  hoursWeekend     String @default("")
  hoursEmergency   String @default("")

  // Integrations
  gtmId      String  @default("") // validated ^GTM-[A-Z0-9]{4,10}$
  gtmEnabled Boolean @default(false)
}

model PaymentMethod {
  id          String  @id
  /// Unique because checkout resolves the method BY NAME: two rows sharing
  /// one made `findFirst` pick an arbitrary winner, and which one decided
  /// whether the order was accepted at all.
  name        String  @unique
  kind        String // "Mobile wallet" | "Card gateway" | "Offline"
  provider    String
  providers   String[] @default([]) // selectable provider options
  enabled     Boolean @default(true)
  environment String  @default("Test") // "Live" | "Test"
  apiKey      String  @default("")
  apiSecret   String  @default("") // never returned by the API
  webhookUrl  String  @default("")
  isGateway   Boolean @default(false)
  sort        Int     @default(0)
}

/// ===== Better Auth (session/credential store) =====
/// Standard Better Auth models plus the fields added by the `username`
/// plugin (staff login) and the custom `phoneNumber` field (customer login
/// identity — email/password under the hood via a synthetic email, see
/// lib/rules.ts `customerEmail`).

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // username plugin (staff)
  username        String? @unique
  displayUsername String?

  // customer login identity (see comment above)
  phoneNumber String? @unique

  sessions Session[]
  accounts Account[]
  staff    Staff?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hashed by Better Auth (scrypt)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
