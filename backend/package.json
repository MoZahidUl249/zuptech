{
  "name": "backend",
  "version": "1.0.50",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "db:generate": "bunx --bun prisma generate",
    "predb:migrate": "bun run scripts/live-guard.ts 'prisma migrate dev'",
    "db:migrate": "bunx --bun prisma migrate dev",
    "predb:deploy": "bun run scripts/live-guard.ts 'prisma migrate deploy'",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "predb:seed": "bun run scripts/live-guard.ts 'the seed'",
    "db:seed": "bun run prisma/seed.ts",
    "db:import:zupplus": "bun run prisma/import-zupplus.ts",
    "db:migrate-media": "bun run prisma/migrate-media-to-cloudinary.ts",
    "db:studio": "bunx --bun prisma studio",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.6.23",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.5.1",
    "elysia": "^1.4.29",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "bun-types": "latest",
    "prisma": "^7.8.0"
  }
}
